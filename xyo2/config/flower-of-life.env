# ENGINE2 Flower of Life Orchestration Configuration
# Sacred Geometry: 1 Center + 6 Petals (6 engines each = 43 total)

# Flower of Life Structure
FLOWER_OF_LIFE_ENABLED=true
FLOWER_TOTAL_ENGINES=43
FLOWER_CENTER_ENGINES=1
FLOWER_PETAL_COUNT=6
FLOWER_ENGINES_PER_PETAL=6

# Center Flower (1 engine) - Operator Plane
# Sacred geometry center: nexus of all operations
FLOWER_CENTER_NAME=operator-sovereign-center
FLOWER_CENTER_ROLE=operator
FLOWER_CENTER_ENGINE_ROLE=sovereign
FLOWER_CENTER_XYO_DEVICE=center

# Petal 1 (6 engines) - Tesla Engine (Motion & Energy)
# Cycle energy distribution
FLOWER_PETAL_1_NAME=Tesla-Petal
FLOWER_PETAL_1_ENGINE_TYPE=tesla
FLOWER_PETAL_1_ENGINE_COUNT=6
FLOWER_PETAL_1_PRIMARY_FUNCTION=motion-energy
FLOWER_PETAL_1_SUBTYPES=motion:energy:motion:energy:motion:energy

# Petal 2 (6 engines) - Einstein Engine (Relativity & Frame)
# Coordinate frames and transformations
FLOWER_PETAL_2_NAME=Einstein-Petal
FLOWER_PETAL_2_ENGINE_TYPE=einstein
FLOWER_PETAL_2_ENGINE_COUNT=6
FLOWER_PETAL_2_PRIMARY_FUNCTION=relativity-frame
FLOWER_PETAL_2_SUBTYPES=relativity:frame:relativity:frame:relativity:frame

# Petal 3 (6 engines) - Newton Engine (Force & Constraint)
# Physical laws and constraints
FLOWER_PETAL_3_NAME=Newton-Petal
FLOWER_PETAL_3_ENGINE_TYPE=newton
FLOWER_PETAL_3_ENGINE_COUNT=6
FLOWER_PETAL_3_PRIMARY_FUNCTION=force-constraint
FLOWER_PETAL_3_SUBTYPES=force:constraint:force:constraint:force:constraint

# Petal 4 (6 engines) - Heke Engine (Navigation & Sovereignty)
# Navigation and sovereign autonomy
FLOWER_PETAL_4_NAME=Heke-Petal
FLOWER_PETAL_4_ENGINE_TYPE=heke
FLOWER_PETAL_4_ENGINE_COUNT=6
FLOWER_PETAL_4_PRIMARY_FUNCTION=navigation-sovereignty
FLOWER_PETAL_4_SUBTYPES=navigation:sovereignty:navigation:sovereignty:navigation:sovereignty

# Petal 5 (6 engines) - Cook Engine (Mapping & Expansion)
# Mapping and system expansion
FLOWER_PETAL_5_NAME=Cook-Petal
FLOWER_PETAL_5_ENGINE_TYPE=cook
FLOWER_PETAL_5_ENGINE_COUNT=6
FLOWER_PETAL_5_PRIMARY_FUNCTION=mapping-expansion
FLOWER_PETAL_5_SUBTYPES=mapping:expansion:mapping:expansion:mapping:expansion

# Petal 6 (6 engines) - Support Planes
# Identity, Routing, Pulse, Audit
FLOWER_PETAL_6_NAME=Support-Petal
FLOWER_PETAL_6_ENGINE_TYPE=mixed
FLOWER_PETAL_6_ENGINE_COUNT=6
FLOWER_PETAL_6_PRIMARY_FUNCTION=identity-routing-pulse-audit
FLOWER_PETAL_6_SUBTYPES=identity:routing-dnssec:routing-zerotrust:routing-cloudflare:pulse:audit

# Flower Cycle Parameters
FLOWER_CYCLE_ENABLED=true
FLOWER_CYCLE_DURATION=1.0
FLOWER_CYCLE_PHASES=6
FLOWER_CYCLE_PHASE_DURATION=0.167
FLOWER_CYCLE_COMPLETION_REQUIRES_ALL_ENGINES=true

# Flower Synchronization
FLOWER_SYNC_ENABLED=true
FLOWER_SYNC_PROTOCOL=distributed_consensus
FLOWER_SYNC_INTERVAL=0.15
FLOWER_SYNC_TOLERANCE=0.01

# XYO Anchoring at Flower Level
FLOWER_XYO_ANCHOR_ENABLED=true
FLOWER_XYO_ANCHOR_LOCATION=/data/xyo-state
FLOWER_XYO_MERKLE_TREE_DEPTH=43

# Device Classification Distribution
# Matariki: 14 engines (6 Tesla + 3 others + 5 distributed)
# Rehua: 14 engines (6 Einstein + 3 others + 5 distributed)
# Altair: 15 engines (6 Newton + 3 others + 6 distributed)

DEVICE_CLASS_MATARIKI_COUNT=14
DEVICE_CLASS_REHUA_COUNT=14
DEVICE_CLASS_ALTAIR_COUNT=15
DEVICE_CLASS_TOTAL_DISTRIBUTED=43

# Health and Monitoring
FLOWER_HEALTH_CHECK_ENABLED=true
FLOWER_HEALTH_CHECK_INTERVAL=5
FLOWER_METRICS_ENABLED=true
FLOWER_METRICS_INTERVAL=10
FLOWER_ALERT_ON_ENGINE_FAILURE=true
