# ENGINE2 XYO Cryptographic Anchoring Configuration
# State anchoring and verification layer

XYO_LAYER_ENABLED=true
XYO_SYSTEM_MODE=production

# XYO Core Architecture
XYO_PROTOCOL_VERSION=4.0
XYO_HEURISTIC_ENABLED=true
XYO_SENTINEL_ENABLED=true

# XYO Hash Configuration
XYO_HASH_ALGORITHM=sha256
XYO_HASH_CHAIN_ENABLED=true
XYO_DOUBLE_HASH_ENABLED=false

# XYO Merkle Tree Configuration
XYO_MERKLE_TREE_ENABLED=true
XYO_MERKLE_TREE_MAX_DEPTH=43
XYO_MERKLE_TREE_VERIFICATION_INTERVAL=10

# XYO Block Configuration
XYO_BLOCK_SIZE_MAXIMUM=1048576
XYO_BLOCK_SIGNATURE_ENABLED=true
XYO_BLOCK_SIGNATURE_ALGORITHM=ed25519
XYO_BLOCK_TIMESTAMP_ENABLED=true
XYO_BLOCK_TIMESTAMP_FORMAT=rfc3339

# XYO Ledger Configuration
XYO_LEDGER_LOCATION=/data/xyo-ledger
XYO_LEDGER_FORMAT=json
XYO_LEDGER_ROTATION_ENABLED=true
XYO_LEDGER_ROTATION_SIZE=104857600
XYO_LEDGER_RETENTION_DAYS=365

# XYO Device Configuration
XYO_DEVICE_REGISTRATION_ENABLED=true
XYO_DEVICE_FINGERPRINT_ENABLED=true
XYO_DEVICE_FINGERPRINT_METHOD=hybrid
XYO_DEVICE_TRUST_SCORE_ENABLED=true

# XYO State Anchoring
XYO_STATE_ANCHOR_ENABLED=true
XYO_STATE_ANCHOR_LOCATION=/app/state/xyo-anchor
XYO_STATE_ANCHOR_FREQUENCY=sync_based
XYO_STATE_ANCHOR_VERIFICATION_ENABLED=true

# XYO Proof Generation
XYO_PROOF_GENERATION_ENABLED=true
XYO_PROOF_TYPE=location_proof
XYO_PROOF_CHAIN_ENABLED=true
XYO_PROOF_TIMESTAMP_ENABLED=true

# XYO Network Communication
XYO_NETWORK_PROTOCOL=grpc
XYO_NETWORK_ENCRYPTION=tls
XYO_NETWORK_TLS_VERSION=1.3
XYO_NETWORK_CERTIFICATE_LOCATION=/etc/xyo/certs

# XYO Validation
XYO_VALIDATION_ENABLED=true
XYO_VALIDATION_STRATEGY=strict
XYO_VALIDATION_FAULT_TOLERANCE=false

# XYO Reporting
XYO_REPORTING_ENABLED=true
XYO_REPORTING_LOCATION=/app/logs/xyo-reports
XYO_REPORTING_FORMAT=json
XYO_REPORTING_INTERVAL=3600

# XYO Integration with Flower of Life
XYO_FLOWER_ANCHOR_ENABLED=true
XYO_FLOWER_CENTER_ANCHOR_ENABLED=true
XYO_FLOWER_PETAL_ANCHOR_ENABLED=true
XYO_FLOWER_ANCHOR_SYNC_INTERVAL=0.15
