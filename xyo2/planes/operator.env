# ENGINE2 Operator Plane Configuration
# Sovereign, non-reactive stance with truth, boundaries, and allowed-states invariants

OPERATOR_PLANE_ENABLED=true
OPERATOR_STANCE=sovereign
OPERATOR_REACTIVE_MODE=false

# Operator Invariants
# These define the non-negotiable rules of the system

# Truth Invariant
OPERATOR_TRUTH_INVARIANT_ENABLED=true
OPERATOR_TRUTH_REQUIREMENT=immutable
OPERATOR_TRUTH_VERIFICATION_METHOD=cryptographic
OPERATOR_TRUTH_AUDIT_LOG_ENABLED=true
OPERATOR_TRUTH_AUDIT_LOG_LOCATION=/app/logs/truth.audit

# Boundaries Invariant
OPERATOR_BOUNDARIES_INVARIANT_ENABLED=true
OPERATOR_BOUNDARIES_DEFINITION=strict
OPERATOR_BOUNDARIES_ENFORCEMENT=absolute
OPERATOR_BOUNDARIES_VIOLATION_ACTION=isolate
OPERATOR_ENFORCE_NAMESPACE_BOUNDARIES=true
OPERATOR_ENFORCE_RESOURCE_BOUNDARIES=true
OPERATOR_ENFORCE_IDENTITY_BOUNDARIES=true

# Allowed-States Invariant
OPERATOR_ALLOWED_STATES_INVARIANT_ENABLED=true
OPERATOR_ALLOWED_STATES_DEFINITION=explicit
OPERATOR_ALLOWED_STATES_WHITELIST_REQUIRED=true
OPERATOR_REJECT_UNDEFINED_STATES=true
OPERATOR_STATE_VALIDATION_ENABLED=true

# Frame-Defining Authority
OPERATOR_FRAME_AUTHORITY=sovereign
OPERATOR_FRAME_DEFINITION_LOCKED=true
OPERATOR_FRAME_CHANGE_REQUIRES_CONSENSUS=false

# Non-Reactive Configuration
OPERATOR_NON_REACTIVE_ENABLED=true
OPERATOR_RESPONSE_MODE=deterministic
OPERATOR_EMOTION_SUPPRESSION=true
OPERATOR_DECISION_ENGINE=rule_based

# Sovereign Decision Making
OPERATOR_SOVEREIGN_DECISION_ENABLED=true
OPERATOR_OVERRIDE_CAPABILITY=enabled
OPERATOR_VETO_AUTHORITY=sovereign
OPERATOR_DISPUTE_RESOLUTION=operator_final

# Operator Configuration
OPERATOR_GATEWAY_HOST=0.0.0.0
OPERATOR_GATEWAY_PORT=5000
OPERATOR_LOG_LEVEL=info
OPERATOR_METRICS_ENABLED=true

# Audit and Compliance
OPERATOR_AUDIT_LOGGING_ENABLED=true
OPERATOR_AUDIT_LOG_RETENTION_DAYS=365
OPERATOR_AUDIT_LOG_LOCATION=/app/logs/operator.audit
OPERATOR_COMPLIANCE_CHECK_INTERVAL=3600

# XYO Operator Anchoring
OPERATOR_XYO_ANCHOR_ENABLED=true
OPERATOR_XYO_DEVICE_TYPE=operator-sovereign
OPERATOR_XYO_ANCHOR_LOCATION=/app/state/xyo-anchor

# State Management
OPERATOR_STATE_PERSISTENCE_ENABLED=true
OPERATOR_STATE_LOCATION=/app/state
OPERATOR_STATE_BACKUP_ENABLED=true
OPERATOR_STATE_BACKUP_INTERVAL=3600

# Health and Liveness
OPERATOR_HEALTH_CHECK_ENABLED=true
OPERATOR_HEALTH_CHECK_INTERVAL=5
OPERATOR_LIVENESS_CHECK_ENABLED=true
OPERATOR_LIVENESS_PROBE_INTERVAL=10
