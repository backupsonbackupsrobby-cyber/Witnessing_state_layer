# ENGINE2 Pulse Plane Configuration
# Cycle timing constants for UI, tactile, wearable, and network interactions

PULSE_PLANE_ENABLED=true

# Pulse Timing Constants (in seconds)
# Defines heartbeat intervals for different interaction channels
PULSE_UI=0.02
PULSE_TACTILE=0.05
PULSE_WEARABLE=0.075
PULSE_NETWORK=0.15

# UI Pulse (0.02s = 50 Hz)
# Fast feedback loop for user interface interactions
PULSE_UI_ENABLED=true
PULSE_UI_INTERVAL=0.02
PULSE_UI_DEVICE_CLASS=high_frequency
PULSE_UI_RESPONSE_TIMEOUT=0.010

# Tactile Pulse (0.05s = 20 Hz)
# Haptic feedback and touch sensor sampling
PULSE_TACTILE_ENABLED=true
PULSE_TACTILE_INTERVAL=0.05
PULSE_TACTILE_DEVICE_CLASS=haptic
PULSE_TACTILE_RESPONSE_TIMEOUT=0.025

# Wearable Pulse (0.075s ≈ 13.3 Hz)
# Wearable device synchronization and biometric sampling
PULSE_WEARABLE_ENABLED=true
PULSE_WEARABLE_INTERVAL=0.075
PULSE_WEARABLE_DEVICE_CLASS=biosensor
PULSE_WEARABLE_RESPONSE_TIMEOUT=0.040

# Network Pulse (0.15s ≈ 6.7 Hz)
# Network synchronization and distributed state updates
PULSE_NETWORK_ENABLED=true
PULSE_NETWORK_INTERVAL=0.15
PULSE_NETWORK_DEVICE_CLASS=distributed
PULSE_NETWORK_RESPONSE_TIMEOUT=0.075

# Flower of Life Cycle Completion
FLOWER_CYCLE_ALIGNMENT_ENABLED=true
FLOWER_CYCLE_TARGET_DURATION=1.0
FLOWER_CYCLE_COMPLETION_CHECK_INTERVAL=0.15

# Pulse Engine Configuration
PULSE_GATEWAY_HOST=0.0.0.0
PULSE_GATEWAY_PORT=5054
PULSE_CLOCK_SOURCE=system
PULSE_JITTER_TOLERANCE=0.002
PULSE_METRICS_ENABLED=true

# XYO Pulse Anchoring
PULSE_XYO_ANCHOR_ENABLED=true
PULSE_XYO_DEVICE_TYPE=pulse-engine
PULSE_XYO_SYNC_INTERVAL=1.0
