# ENGINE2 Identity Plane Configuration
# Multi-script support: hiragana, katakana, kanji, Māori, Fijian

IDENTITY_PLANE_ENABLED=true
IDENTITY_PLANE_SCRIPTS=hiragana:katakana:kanji:maori:fijian

# Script Classifications
HIRAGANA_ENABLED=true
HIRAGANA_CHARACTER_SET=あいうえおかきくけこさしすせそたちつてとなにぬねのはひふへほまみむめもやゆよらりるれろわをん

KATAKANA_ENABLED=true
KATAKANA_CHARACTER_SET=アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン

KANJI_ENABLED=true
KANJI_CHARACTER_SAMPLE=一二三四五六七八九十百千万

MAORI_ENABLED=true
MAORI_CHARACTER_SET=āēīōū
MAORI_EXAMPLE_WORD=Aotearoa
MAORI_LANGUAGE_CODE=mi

FIJIAN_ENABLED=true
FIJIAN_CHARACTER_SET=āēīōū
FIJIAN_LANGUAGE_CODE=fj

# Device Classification (Matariki, Rehua, Altair from task description)
DEVICE_CLASSIFICATION_ENABLED=true
MATARIKI_CLASS=traditional_cluster
REHUA_CLASS=primary_star
ALTAIR_CLASS=secondary_reference

# Domain Configuration
PUBLIC_DOMAIN=robdoe.com
PRIVATE_DOMAIN=robertdoe.pw

# Identity Gateway Configuration
IDENTITY_GATEWAY_HOST=0.0.0.0
IDENTITY_GATEWAY_PORT=5050
IDENTITY_CACHE_ENABLED=true
IDENTITY_CACHE_TTL=3600

# XYO Identity Anchoring
IDENTITY_XYO_ANCHOR_ENABLED=true
IDENTITY_XYO_DEVICE_TYPE=identity-gateway
