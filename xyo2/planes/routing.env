# ENGINE2 Routing Plane Configuration
# DNSSEC + ZeroTrust DNS + Cloudflare Tunnels + Operator-defined identity routing

ROUTING_PLANE_ENABLED=true

# DNSSEC Configuration
DNSSEC_ENABLED=true
DNSSEC_MODE=full
DNSSEC_VALIDATION=strict
DNSSEC_KEY_ROTATION_INTERVAL=86400

# ZeroTrust DNS Configuration
ZEROTRUST_DNS_ENABLED=true
ZEROTRUST_ENFORCE=true
ZEROTRUST_POLICY_MODE=restrictive
ZEROTRUST_DEVICE_TRUST_REQUIRED=true

# Cloudflare Tunnel Configuration
CLOUDFLARE_TUNNEL_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_SECRET=

# Domain Routing
PUBLIC_DOMAIN=robdoe.com
PRIVATE_DOMAIN=robertdoe.pw

# Public Domain (robdoe.com) - ZeroTrust DNS required
PUBLIC_DOMAIN_DNS_SERVER=8.8.8.8
PUBLIC_DOMAIN_DNSSEC_VERIFY=true
PUBLIC_DOMAIN_TTL=300

# Private Domain (robertdoe.pw) - Enhanced security
PRIVATE_DOMAIN_DNS_SERVER=127.0.0.1
PRIVATE_DOMAIN_DNSSEC_VERIFY=true
PRIVATE_DOMAIN_TTL=300
PRIVATE_DOMAIN_REQUIRE_IDENTITY_VERIFICATION=true

# Operator-Defined Identity Routing
OPERATOR_ROUTING_ENABLED=true
OPERATOR_IDENTITY_ROUTING_ENABLED=true
OPERATOR_DEFINE_ALLOWED_IDENTITIES=true

# Routing Engine Configuration
ROUTING_GATEWAY_HOST=0.0.0.0
ROUTING_GATEWAY_PORT=5051
ROUTING_DNSSEC_PORT=53
ROUTING_METRICS_ENABLED=true
ROUTING_LOG_LEVEL=info

# XYO Routing Anchoring
ROUTING_XYO_ANCHOR_ENABLED=true
ROUTING_XYO_DEVICE_TYPE=routing-engine
